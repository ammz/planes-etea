			$(document).ready(function(){
				$.ajax({
			        async:true,
			        cache:false,
			        dataType:"json",
			        type: 'GET',
			        data: {},
			        url: url_base + "avisosusuarios/getBloqueoActual/json",
			        success:  function(data){
						if (typeof data.hours != "undefined" && data.hours != ""){
						   	loadCSS("/intranet/admin/resources/flipclock/", "flipclock.css", "flipclock_css");
						   	loadJS("/intranet/admin/resources/flipclock/", "flipclock.min.js", "flipclock_min_js");
						   	informaBloqueo(data);
						   	$(".pull-right.clock").show();
						   	ajustaCabecera();
			        	}
			        },
			        error:function(objXMLHttpRequest){
			        }
				});				
			});
			
			function ajustaCabecera(){
				var anchoTotal = $(".cabecera").width();
				var anchoLogin = $(".header-login.pull-right").width();				
				var anchoBloqueo = $(".pull-right.clock").width();				
				var anchoLogo = 360;
				
				var sumaIzq = anchoBloqueo + anchoLogo;
				var limitLogin = anchoTotal - sumaIzq;
				if (limitLogin < anchoLogin){
					var exceso = anchoLogin - limitLogin;
					var anchoAct = $("#actividad_seleccionada_info").width();					
					var anchoUser = $(".username").width();
					var porcAct = (anchoAct + anchoUser) / anchoAct;
					var porcUser = 1 - porcAct;
					var maxAnchoAct = parseInt(anchoAct - (exceso * porcAct)); 
					var maxAnchoUser = parseInt(anchoUser - (exceso * porcUser));
					if (maxAnchoAct < 0){
						maxAnchoUser = maxAnchoUser + maxAnchoAct - 30;
						maxAnchoAct = 30;
					}
					if (maxAnchoUser < 0){
						maxAnchoAct = maxAnchoAct + maxAnchoUser - 30;
						maxAnchoUser = 30;
					}
					
					if (maxAnchoAct < 0){
						maxAnchoAct = 30;
					}
					
					if (maxAnchoUser < 0){
						maxAnchoUser = 30;
					}
					$("#actividad_seleccionada_info").css({"maxWidth": maxAnchoAct});
					$("div.username").css({"maxWidth": maxAnchoUser});
				}
			}
			
			var bloqueo_titulo="";
			var bloqueo_mensaje="";
			function informaBloqueo(counterDown){
				bloqueo_titulo = counterDown.titulo;
				bloqueo_mensaje = counterDown.mensaje;
				
				var countH = counterDown.hours * 60 * 60;
				var countM = counterDown.minutes * 60;
				var countS = counterDown.seconds;
				var clock = $(".clock .timer").FlipClock(0, {
					countdown: true,
				    clockFace: 'HourlyCounter',
				    excludeMinutes: true,
				    autoStart: false,
				    language: 'spanish',
				    callbacks: {
						interval: function(){
							if (clock.getTime() == 0){
							}        
						}
					}
				});
				clock.setTime(parseInt(countH) + parseInt(countM) + parseInt(countS));
				clock.start(); 
			}
			
			function showMasInfoAviso(){
				$(".modal-title strong").html(bloqueo_titulo); 
				$(".modal-body div").html(bloqueo_mensaje);
				$('#masInfoAviso').modal('show');
			}
