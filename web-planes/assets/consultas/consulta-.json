	function addMensaje_mensajeDefault(mensaje,titulo){
		$('#_mensajeDefault_mensajes_util ul').empty();
		if(typeof mensaje == "string"){
			var nuevoLi = $('<li/>').html(mensaje);
			$('#_mensajeDefault_mensajes_util ul').append(nuevoLi);
		}else{
			for(var aux in mensaje){
				var nuevoLi = $('<li/>');
				nuevoLi.html(mensaje[aux]);
				$('#_mensajeDefault_mensajes_util ul').append(nuevoLi);
			}				
		}
		if(titulo != null){
			$('#_mensajeDefault_mensajes_util .modal-title').text(titulo);
		}
		$('#_mensajeDefault_mensajes_util.no-display').removeClass('no-display');
		$('#_mensajeDefault_mensajes_util').modal('show');
	}
	function ocultarMensaje_mensajeDefault(){
		$('#_mensajeDefault_mensajes_util').modal('hide');
	}
</script><div aria-hidden="true" aria-labelledby="mySmallModalLabel" role="dialog" tabindex="-1" backdrop="static" class="modal bs-example-modal-sm" id="loading-indicator"><img style="position:absolute;top:40%;left:45%;" src="/intranet/admin/resources/images/ajax-loader.gif" alt="Badea"/></div></body></html>