lter(&#xA;&#x9;     (values) =&gt; (!values[2].startsWith(&#34;estado&#34;))).filter(&#xA;&#x9;&#x9; (values) =&gt; (values[territ] == And));&#xA;     }&#xA;&#xA;     if (numSeries == 2) {&#xA;&#x9; misdatos = datos.slice(1).filter(&#xA;&#x9;     (values) =&gt; (!values[2].startsWith(&#34;estado&#34;))).filter((values) =&gt;&#xA;&#x9;&#x9; (values[territ] == And ||&#xA;&#x9;&#x9;  values[territ] == Esp));&#xA;     }&#xA;&#xA;     if (numSeries == 3) {&#xA;&#x9; misdatos = datos.slice(1).filter(&#xA;&#x9;     (values) =&gt; (!values[2].startsWith(&#34;estado&#34;))).filter((values) =&gt;&#xA;&#x9;&#x9; (values[territ] == And ||&#xA;&#x9;&#x9;  values[territ] == Esp ||&#xA;&#x9;&#x9;  values[territ] == UE));&#xA;     }&#xA;&#xA;     if (numSeries &gt; 3) {&#xA;&#x9; misdatos = datos.slice(1).filter(&#xA;&#x9;     (values) =&gt; (!values[2].startsWith(&#34;estado&#34;))).filter((values) =&gt;&#xA;&#x9;&#x9; (values[territ] == And ||&#xA;&#x9;&#x9;  values[territ] == Esp));&#xA;     }&#xA;&#xA;     var html = pivotTable(misdatos, valores, filas, columnas);&#xA;     document.getElementById(&#34;tabla-0&#34;).innerHTML = html;&#xA; }&#xA; noTabla = false;&#xA;&lt;/script&gt;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&lt;div class=&#34;bg-white my-2 py-1&#34;&gt;&#xA;&#xA;  &#xA;  &lt;div class=&#34;flex items-center justify-between mt-2 pt-1&#34;&gt;&#xA;    &lt;div class=&#34;bg-orange-100 mr-1 py-1 rounded-t-lg&#34;&gt;&#xA;      &lt;h3 class=&#34;px-2 text-orange-500 text-lg/6&#34;&gt; Proporción de vivienda rehabilitada protegida &lt;/h3&gt;&#xA;    &lt;/div&gt;&#xA;    &lt;div class=&#34;flex justify-end min-w-26&#34;&gt;&#xA;      &lt;a class=&#34;px-2 py-1 bg-sky-300 hover:bg-sky-400 text-white text-xs rounded-full&#34;&#xA;&#x9; href=&#34;https://www.juntadeandalucia.es/institutodeestadisticaycartografia/badea/operaciones/consulta/anual/108271&#34;&#xA;&#x9; target=&#34;_blank&#34;&gt;&#xA;&#x9;Datos en IECA&#xA;      &lt;/a&gt;&#xA;    &lt;/div&gt;&#xA;  &lt;/div&gt;&#xA;&#xA;  &#xA;  &lt;div class=&#34;border border-orange-100 border-l-8&#34; id=&#34;Chart1&#34;&gt;&lt;/div&gt;&#xA;&#xA;  &#xA;  &lt;div class=&#34;border border-orange-100 mt-1 p-3&#34;&gt;&#xA;    &lt;table id=&#34;tabla-1&#34; class=&#34;table table-zebra table-xs&#34;&gt;&lt;/table&gt;&#xA;  &lt;/div&gt;&#xA;&#xA;  &#xA;  &#xA;  &lt;details class=&#34;p-0 mb-1 ml-4&#34;&gt;&#xA;    &lt;summary&gt;&lt;spam class=&#34;border-b-3 border-sky-400 text-xs text-gray-500&#34;&gt;Notas&lt;/spam&gt;&lt;/summary&gt;&#xA;    &lt;div class=&#34;text-xs ml-3 rounded-sm border-1 border-gray-300 bg-yellow-100/10 p-2&#34;&gt;&#xA;      &lt;br /&gt;&lt;br /&gt;&lt;strong&gt;Definición: &lt;/strong&gt;Proporción de vivienda rehabilitada protegida del parque residencial (número de aprobaciones definitivas de los planes estatales y autonómicos) en relación a la estimación del parque de viviendas.&lt;br /&gt;&lt;br /&gt;&lt;strong&gt;&lt;strong&gt;&lt;strong&gt;Observaciones: &lt;/strong&gt;&lt;/strong&gt;&lt;/strong&gt;En julio de 2023 se actualizó la serie de la Estimación del Parque de Viviendas a partir de los datos del Censo de Viviendas de 2021 &lt;p style=&#39;margin: 0in; font-family: Calibri; font-size: 11.0pt;&#39;&gt; &lt;/p&gt;</description>
