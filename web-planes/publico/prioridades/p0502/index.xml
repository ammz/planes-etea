e&#xA;&#x9; },&#xA;&#x9; toolbar: {&#xA;&#x9;     show: true&#xA;&#x9; }&#xA;     },&#xA;     tooltip: {&#xA;&#x9; y: {&#xA;&#x9;     formatter: function(value, {series, seriesIndex, dataPointIndex, w}) {&#xA;&#x9;&#x9; if (value == null) {&#xA;&#x9;&#x9;     value = &#39;&#39;;&#xA;&#x9;&#x9; } else {&#xA;&#x9;&#x9;     value = value.toLocaleString(&#39;de-DE&#39;, {maximumFractionDigits: 2});&#xA;&#x9;&#x9; }&#xA;&#x9;&#x9; return value;&#xA;&#x9;     }&#xA;&#x9; },&#xA;     },&#xA;     plotOptions: {&#xA;&#x9; bar: {dataLabels: {position: &#39;top&#39;}}&#xA;     },&#xA;     colors: [verde, rojo, azul, gris, amarillo],&#xA;     stroke: {&#xA;&#x9; curve: &#39;smooth&#39;&#xA;     },&#xA;     grid: {&#xA;&#x9; borderColor: &#39;#e7e7e7&#39;,&#xA;&#x9; row: {&#xA;&#x9;     colors: [&#39;#f3f3f3&#39;, &#39;transparent&#39;],&#xA;&#x9;     opacity: 0.5&#xA;&#x9; },&#xA;     },&#xA;     annotations: {},&#xA;     markers: {&#xA;&#x9; size: 1&#xA;     },&#xA;     legend: {&#xA;&#x9; position: &#39;top&#39;,&#xA;&#x9; horizontalAlign: &#39;center&#39;,&#xA;&#x9; floating: false,&#xA;&#x9; offsetY: 0,&#xA;&#x9; offsetX: -5&#xA;     },&#xA;     dataLabels: {&#xA;&#x9; enabled: true,&#xA;&#x9; formatter: function(value, {seriesIndex, dataPointIndex, w}) {&#xA;&#x9;     if (value == null) {&#xA;&#x9;&#x9; value = &#39;&#39;;&#xA;&#x9;     } else if (Number(value) &lt; 100) {&#xA;&#x9;&#x9; value = value.toLocaleString(&#39;de-DE&#39;, {&#xA;&#x9;&#x9;     maximumFractionDigits: 2,&#xA;&#x9;&#x9;     minimumFractionDigits: 2});&#xA;&#x9;     } else {&#xA;&#x9;&#x9; value = (value | 0).toLocaleString(&#39;de-DE&#39;);&#xA;&#x9;     }&#xA;&#x9;     return value}&#xA;     },&#xA;     xaxis: {&#xA;&#x9; title: {&#xA;&#x9;     text: &#39;Años&#39;&#xA;&#x9; },&#xA;&#x9; tickPlacement: &#39;between&#39;,&#xA;     },&#xA;     yaxis: {&#xA;&#x9; labels: {&#xA;&#x9;     formatter: function (value) {&#xA;&#x9;&#x9; if (value == null) {&#xA;&#x9;&#x9;     value = &#39;&#39;;&#xA;&#x9;&#