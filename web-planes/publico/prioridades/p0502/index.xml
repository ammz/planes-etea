(discontinuo == true) {&#xA;     &#xA;     var ajusteAnd = data.filter((value) =&gt; value[indTerritorio].des == And &amp;&amp; value[indYear].des &gt;= yearIni).map((value) =&gt; [value[indYear].des, value[medida].val]);&#xA;     var ajusteEsp = data.filter((value) =&gt; value[indTerritorio].des == Esp &amp;&amp; value[indYear].des &gt;= yearIni).map((value) =&gt; [value[indYear].des, value[medida].val]);&#xA;&#xA;     var AndTotal = [];&#xA;     var EspTotal = [];&#xA;&#xA;     var ok = false;&#xA;     for (let i = 0; i &lt; myyears.length; i++) {&#xA;&#x9; let j = 0;&#xA;&#x9; ok = false;&#xA;&#x9; while (j &lt; ajusteAnd.length) {&#xA;&#x9;     if (ajusteAnd[j][0] == myyears[i]) {&#xA;&#x9;&#x9; if (ajusteEsp.length != 0) {EspTotal.push(ajusteEsp[j][1]);}&#xA;&#x9;&#x9; AndTotal.push(ajusteAnd[j][1]);&#xA;&#x9;&#x9; ok = true;&#xA;&#x9;&#x9; break;&#xA;&#x9;     } else {&#xA;&#x9;&#x9; j++;&#xA;&#x9;     }&#xA;&#x9; }&#xA;&#x9; if (ok == false) {&#xA;&#x9;     AndTotal.push(null);&#xA;&#x9;     EspTotal.push(null);&#xA;&#x9; }&#xA;     }&#xA; }&#xA;&#xA; var years = myyears;&#x9; &#xA; if (objetivo) {&#xA;     years = years_obj;&#xA; }&#xA;&#xA;&#xA; if (numSeries == 1) {&#xA;     options = {...options,&#xA;&#x9;&#x9;series: [&#xA;&#x9;&#x9;    {name: And, data: AndTotal}&#xA;&#x9;&#x9;]&#xA;     };&#xA; }&#xA;&#xA; if (numSeries == 2) {&#xA;     options = { ...options,&#xA;&#x9;&#x9; series: [&#xA;&#x9;&#x9;     {name: And, data: AndTotal, zIndex: 10},&#xA;&#x9;&#x9;     {name: Esp, data: EspTotal}&#xA;&#x9;&#x9; ]&#xA;     };&#xA; }&#xA;&#xA; if (numSeries == 3) {&#xA;     options = { ...options,&#xA;&#x9;&#x9; series: [&#xA;&#x9;&#x9;     {name: And, data: AndTotal, zIndex: 10},&#xA;&#x9;&#x9;     {name: Esp, data: EspTotal},&#xA;&#x9;&#x9;     {name: UE, data: UETotal}&#xA;&#x9;&#x9; ]&#xA;     };&#xA; }&#xA;&#xA; if (numSeries &gt; 3) {&#xA;     options = {...options,&#xA;&#x9;&#x9;series: [{ ...serie1And},&#xA;&#x9;&#x9;&#x9; { ...serie2And},&#xA;&#x9;&#x9;&#x9; { ...serie1Esp},&#xA;&#x9;&#x9;&#x9; { ...serie2Esp},&#xA;     ]};&#xA; }&#xA;&#xA; options.xaxis = {...options.xaxis, categories: years};&#xA;&#xA; eval(&#34;var Chart0 = new ApexCharts(ctx, options);&#34;);&#xA; eval(&#34;Chart0.render();&#34;);&#xA;&#xA; &#xA; if (ocultaEsp == true) {&#xA;     eval(`Chart0.hideSeries(&#39;${Esp}&#39;)`);&#xA; }&#xA; if (ocultaUE == true) {&#xA;     eval(`Chart0.hideSeries(&#39;${UE}&#39;)`);&#xA; }&#xA; ocultaEsp == false;&#xA; ocultaUE == false;&#xA;&#xA; if (ocultaCatEsp == true) {&#xA;     eval(`Chart0.hideSeries(&#39;${cat1Esp}&#39;)`);&#xA;     eval(`Chart0.hideSeries(&#39;${cat2Esp}&#39;)`);&#xA; }&#xA; ocultaCatEsp == false;&#xA;&lt;/script&gt;&#xA;&#xA;&lt;script&gt;&#xA; if (noTabla == false) {&#xA;     var datos = convertCSV(datapoints, indYear, yearIni);&#xA;     &#xA;     var valores = datos[0].indexOf(&#34;valor&#34;);&#xA;     var territ = datos[0].indexOf(&#34;Territorio&#34;);&#xA;     &#xA;     var misdatos = [];&#xA;&#xA;     if (numSeries == 1 || numSeries == 0) {&#xA;&#x9; misdatos = datos.slice(1).filter(&#xA;&#x9;     (values) =&gt; (!values[2].startsWith(&#34;estado&#34;))).filter(&#xA;&#x9;&#x9; (values) =&gt; (values[territ] == And));&#xA;     }&#xA;&#xA;     if (numSeries == 2) {&#xA;&#x9; misdatos = datos.slice(1).filter(&#xA;&#x9;     (values) =&gt; (!values[2].startsWith(&#34;estado&#34;))).filter((values) =&gt;&#xA;&#x9;&#x9; (values[territ] == And ||&#xA;&#x9;&#x9;  values[territ] == Esp));&#xA;     }&#xA;&#xA;     if (numSeries == 3) {&#xA;&#x9; misdatos = datos.slice(1).filter(&#xA;&#x9;     (values) =&gt; (!values[2].startsWith(&#34;estado&#34;))).filter((values) =&gt;&#xA;&#x9;&#x9; (values[territ] == And ||&#xA;&#x9;&#x9;  values[territ] == Esp ||&#xA;&#x9;&#x9;  values[territ] == UE));&#xA;     }&#xA;&#xA;     if (numSeries &gt; 3) {&#xA;&#x9; misdatos = datos.slice(1).filter(&#xA;&#x9;     (values) =&gt; (!values[2].startsWith(&#34;estado&#34;))).filter((values) =&gt;&#xA;&#x9;&#x9; (values[territ] == And ||&#xA;&#x9;&#x9;  values[territ] == Esp));&#xA;     }&#xA;&#xA;     var html = pivotTable(misdatos, valores, filas, columnas);&#xA;     document.getElementById(&#34;tabla-0&#34;).innerHTML = html;&#xA; }&#xA; noTabla = false;&#xA;&lt;/script&gt;</description>
