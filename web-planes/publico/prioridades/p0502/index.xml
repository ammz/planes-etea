urbanización en Andalucía\u0022,\u0022subtitle\u0022:\u0022\u0022,\u0022activity\u0022:\u0022Inventario de indicadores para la planificación y el seguimiento de políticas públicas.\u0022,\u0022source\u0022:\u0022\u0022,\u0022periodicity\u0022:\u0022Anual\u0022,\u0022type\u0022:\u0022I\u0022,\u0022notes\u0022:\u0022\u003cbr \/\u003e\u003cbr \/\u003e\u003cstrong\u003eDefinici\u0026oacute;n:\u0026nbsp;\u003c\/strong\u003eN\u0026uacute;mero de centros de salud seg\u0026uacute;n el grado de urbanizaci\u0026oacute;n del municipio.\u003cstrong\u003e\u003cstrong\u003e\u003cbr \/\u003e\u003c\/strong\u003e\u003c\/strong\u003e\u0022},\u0022hierarchies\u0022:[{\u0022url\u0022:\u0022https:\/\/www.juntadeandalucia.es\/institutodeestadisticaycartografia\/intranet\/admin\/rest\/v1.0\/jerarquia\/21033?consultaId=108421\u0026alias=D_TERR_PLANIF_0\u0022,\u0022cod\u0022:\u0022d11479_j21033\u0022,\u0022des\u0022:\u0022Territorio\u0022,\u0022position\u0022:\u0022f\u0022,\u0022order\u0022:0,\u0022alias\u0022:\u0022D_TERR_PLANIF_0\u0022,\u0022levels\u0022:[{\u0022id\u0022:22677,\u0022name\u0022:\u0022NIVEL1\u0022,\u0022order\u0022:0},{\u0022id\u0022:22678,\u0022name\u0022:\u0022NIVEL2\u0022,\u0022order\u0022:1}]},{\u0022url\u0022:\u0022https:\/\/www.juntadeandalucia.es\/institutodeestadisticaycartografia\/intranet\/admin\/rest\/v1.0\/jerarquia\/2?consultaId=108421\u0026alias=D_TEMPORAL_0\u0022,\u0022cod\u0022:\u0022d1_j2\u0022,\u0022des\u0022:\u0022Anual\u0022,\u0022position\u0022:\u0022c\u0022,\u0022order\u0022:0,\u0022alias\u0022:\u0022D_TEMPORAL_0\u0022,\u0022levels\u0022:[{\u0022id\u0022:1,\u0022name\u0022:\u0022Año\u0022,\u0022order\u0022:0}]},{\u0022url\u0022:\u0022https:\/\/www.juntadeandalucia.es\/institutodeestadisticaycartografia\/intranet\/admin\/rest\/v1.0\/jerarquia\/22?consultaId=108421\u0026alias=D_SEXO_0\u0022,\u0022cod\u0022:\u0022d22_j22\u0022,\u0022des\u0022:\u0022Sexo\u0022,\u0022position\u0022:\u0022p\u0022,\u0022order\u0022:0,\u0022alias\u0022:\u0022D_SEXO_0\u0022,\u0