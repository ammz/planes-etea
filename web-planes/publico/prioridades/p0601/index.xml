				<description>&lt;div class=&#34;bg-white my-2 py-1&#34;&gt;&#xA;&#xA;  &#xA;  &lt;div class=&#34;flex items-center justify-between mt-2 pt-1&#34;&gt;&#xA;    &lt;div class=&#34;bg-orange-100 mr-1 py-1 rounded-t-lg&#34;&gt;&#xA;      &lt;h3 class=&#34;px-2 text-orange-500 text-lg/6&#34;&gt; Índice europeo de calidad institucional &lt;/h3&gt;&#xA;    &lt;/div&gt;&#xA;    &lt;div class=&#34;flex justify-end min-w-26&#34;&gt;&#xA;      &lt;a class=&#34;px-2 py-1 bg-sky-300 hover:bg-sky-400 text-white text-xs rounded-full&#34;&#xA;&#x9; href=&#34;https://www.juntadeandalucia.es/institutodeestadisticaycartografia/badea/operaciones/consulta/anual/108439&#34;&#xA;&#x9; target=&#34;_blank&#34;&gt;&#xA;&#x9;Datos en IECA&#xA;      &lt;/a&gt;&#xA;    &lt;/div&gt;&#xA;  &lt;/div&gt;&#xA;&#xA;  &#xA;  &lt;div class=&#34;border border-orange-100 border-l-8&#34; id=&#34;Chart0&#34;&gt;&lt;/div&gt;&#xA;&#xA;  &#xA;  &lt;div class=&#34;border border-orange-100 mt-1 p-3&#34;&gt;&#xA;    &lt;table id=&#34;tabla-0&#34; class=&#34;table table-zebra table-xs&#34;&gt;&lt;/table&gt;&#xA;  &lt;/div&gt;&#xA;&#xA;  &#xA;  &#xA;  &lt;details class=&#34;p-0 mb-1 ml-4&#34;&gt;&#xA;    &lt;summary&gt;&lt;spam class=&#34;border-b-3 border-sky-400 text-xs text-gray-500&#34;&gt;Notas&lt;/spam&gt;&lt;/summary&gt;&#xA;    &lt;div class=&#34;text-xs ml-3 rounded-sm border-1 border-gray-300 bg-yellow-100/10 p-2&#34;&gt;&#xA;      &lt;br /&gt;&lt;br /&gt;&lt;strong&gt;Definición: &lt;/strong&gt;La calidad institucional se define como un concepto multidimensional que consiste en una alta imparcialidad y calidad de la prestación de servicios públicos, junto con un nivel bajo de corrupción.&lt;strong&gt;&lt;strong&gt;&lt;br /&gt;&lt;/strong&gt;&lt;/strong&gt;&lt;/div&gt;&#xA;  &lt;/details&gt;&#xA;  &#xA;&#xA;&lt;/div&gt;&#xA;&#xA;&lt;script&gt;&#xA; var ctx = document.querySelector(&#34;#Chart0&#34;);&#xA; var yearIni = &#34;2010&#34;;&#xA;&#xA; var jsonData = &#39;{\u0022metainfo\u0022:{\u0022id\u0022:108439,\u0022title\u0022:\u0022Índice europeo de calidad institucional\u0022,\u0022subtitle\u0022:\u0022\u0022,\u0022activity\u0022:\u0022Inventario de indicadores para la planificación y el seguimiento de políticas públicas.\u0022,\u0022source\u0022:\u0022\u0022,\u0022periodicity\u0022:\u0022Irregular\u0022,\u0022type\u0022:\u0022I\u0022,\u0022notes\u0022:\u0022\u003cbr \/\u003e\u003cbr \/\u003e\u003cstrong\u003eDefinici\u0026oacute;n:\u0026nbsp;\u003c\/strong\u003eLa calidad institucional se define como un concepto multidimensional que consiste en una alta imparcialidad y calidad de la prestaci\u0026oacute;n de servicios p\u0026uacute;blicos, junto con un nivel bajo de corrupci\u0026oacute;n.\u003cstrong\u003e\u003cstrong\u003e\u003cbr \/\u003e\u003c\/strong\u003e\u003c\/strong\u003e\u0022},\u0022hierarchies\u0022:[{\u0022url\u0022:\u0022https:\/\/www.juntadeandalucia.es\/institutodeestadisticaycartografia\/intranet\/admin\/rest\/v1.0\/jerarquia\/21033?consultaId=108439\u0026alias=D_TERR_PLANIF_0\u0022,\u0022cod\u0022:\u0022d11479_j21033\u0022,\u0022des\u0022:\u0022Territorio\u0022,\u0022position\u0022:\u0022f\u0022,\u0022order\u0022:0,\u0022alias\u0022:\u0022D_TERR_PLANIF_0\u0022,\u0022levels\u0022:[{\u0022id\u0022:22677,\u0022name\u0022:\u0022NIVEL1\u0022,\u0022order\u0022:0},{\u0022id\u0022:22678,\u0022name\u0022:\u0022NIVEL2\u0022,\u0022order\u0022:1}]},{\u0022url\u0022:\u0022https:\/\/www.juntadeandalucia.es\/institutodeestadisticaycartografia\/intranet\/admin\/rest\/v1.0\/jerarquia\/2?consultaId=108439\u0026alias=D_TEMPORAL_0\u0022,\u0022cod\u0022:\u0022d1_j2\u0022,\u0022des\u0022:\u0022Anual\u0022,\u0022position\u0022:\u0022c\u0022,\u0022order\u0022:0,\u0022alias\u0022:\u0022D_TEMPORAL_0\u0022,\u0022levels\u0022:[{\u0022id\u0022:1,\u0022name\u0022:\u0022Año\u0022,\u0022order\u0022:0}]},{\u0022url\u0022:\u0022https:\/\/www.juntadeandalucia.es\/institutodeestadisticaycartografia\/intranet\/admin\/rest\/v1.0\/jerarquia\/22?consultaId=108439\u0026alias=D_SEXO_0\u0022,\u0022cod\u0022:\u0022d22_j22\u0022,\u0022des\u0022:\u0022Sexo\u0022,\u0022position\u0022:\u0022p\u0022,\u0022order\u0022:0,\u0022alias\u0022:\u0022D_SEXO_0\u0022,\u0022levels\u0022:[{\u0022id\u0022:28,\u0022name\u0022:\u0022Nivel0\u0022,\u0022order\u0022:0},{\u0022id\u0022:29,\u0022name\u0022:\u0022Nivel1\u0022,\u0022order\u0022:1}]}],\u0022measures\u0022:[{\u0022id\u0022:700717,\u0022des\u0022:\u0022Índice europeo de calidad institucional\u0022,\u0022position\u0022:\u0022f\u0022,\u0022order\u0022:0,\u0022type\u0022:\u0022m\u0022}],\u0022data\u0022:[[{\u0022cod\u0022:[\u0022C01\u0022], \u0022des\u0022:\u0022Andalucía\u0022},{\u0022cod\u0022:[\u00222024\u0022], \u0022des\u0022:\u00222024\u0022},{\u0022cod\u0022:[\u0022NP\u0022], \u0022des\u0022:\u0022No procede\u0022},{\u0022val\u0022:\u0022-0.764\u0022, \u0022format\u0022:\u0022-0,76\u0022}],[{\u0022cod\u0022:[\u0022C01\u0022], \u0022des\u0022:\u0022Andalucía\u0022},{\u0022cod\u0022:[\u00222021\u0022], \u0022des\u0022:\u00222021\u0022},{\u0022cod\u0022:[\u0022NP\u0022], \u0022des\u0022:\u0022No procede\u0022},{\u0022val\u0022:\u0022-0.523\u0022, \u0022format\u0022:\u0022-0,52\u0022}],[{\u0022cod\u0022:[\u0022C01\u0022], \u0022des\u0022:\u0022Andalucía\u0022},{\u0022cod\u0022:[\u00222017\u0022], \u0022des\u0022:\u00222017\u0022},{\u0022cod\u0022:[\u0022NP\u0022], \u0022des\u0022:\u0022No procede\u0022},{\u0022val\u0022:\u0022-0.642\u0022, \u0022format\u0022:\u0022-0,64\u0022}],[{\u0022cod\u0022:[\u0022C01\u0022], \u0022des\u0022:\u0022Andalucía\u0022},{\u0022cod\u0022:[\u00222013\u0022], \u0022des\u0022:\u00222013\u0022},{\u0022cod\u0022:[\u0022NP\u0022], \u0022des\u0022:\u0022No procede\u0022},{\u0022val\u0022:\u0022-0.054\u0022, \u0022format\u0022:\u0022-0,05\u0022}],[{\u0022cod\u0022:[\u0022C01\u0022], \u0022des\u0022:\u0022Andalucía\u0022},{\u0022cod\u0022:[\u00222010\u0022], \u0022des\u0022:\u00222010\u0022},{\u0022cod\u0022:[\u0022NP\u0022], \u0022des\u0022:\u0022No procede\u0022},{\u0022val\u0022:\u0022-0.111\u0022, \u0022format\u0022:\u0022-0,11\u0022}]]}&#39;;&#xA; var datapoints = JSON.parse(jsonData);&#xA; var data = datapoints.data;&#xA;&#xA; var And = &#34;Andalucía&#34;;&#xA; var Esp = &#34;España&#34;;&#xA; var UE = &#34;Unión Europea 27 (desde 2020)&#34;;&#xA;&#xA; var verde = &#39;#0e6926&#39;;&#xA; var rojo = &#39;#CC4422&#39;; &#xA; var azul = &#39;#77B6EA&#39;;&#xA; var gris = &#39;#c2c2bd&#39;;&#xA; var amarillo = &#39;#f2f45e&#39;;&#xA;&#xA; var objetivo = false;&#xA; var years_obj = [];&#xA; for (let i = Number(yearIni); i &lt;= 2027; i++) {&#xA;     years_obj[i-Number(yearIni)] = i.toString();&#xA; }&#xA;&#xA; var noTabla = false;&#xA; var conCategorias = false;&#xA; var discontinuo = false;&#xA; var ocultaEsp = false;&#xA; var ocultaUE = false;&#xA; var ocultaCatEsp = false;&#xA; var orden = 0; &#xA;&#xA; var options = {&#xA;     chart: {&#xA;&#x9; height: 350,&#xA;&#x9; type: &#39;bar&#39;,&#xA;&#x9; stacked: false,&#xA;&#x9; dropShadow: {&#xA;&#x9;     enabled: false,&#xA;&#x9;     color: &#39;#000&#39;,&#xA;&#x9;     top: 18,&#xA;&#x9;     left: 7,&#xA;&#x9;     blur: 10,&#xA;&#x9;     opacity: 0.2,&#xA;&#x9; },&#xA;&#x9; zoom: {&#xA;&#x9;     enabled: false&#xA;&#x9; },&#xA;&#x9; toolbar: {&#xA;&#x9;     show: true&#xA;&#x9; }&#xA;     },&#xA;     tooltip: {&#xA;&#x9; y: {&#xA;&#x9;     formatter: function(value, {series, seriesIndex, dataPointIndex, w}) {&#xA;&#x9;&#x9; if (value == null) {&#xA;&#x9;&#x9;     value = &#39;&#39;;&#xA;&#x9;&#x9; } else {&#xA;&#x9;&#x9;     value = value.toLocaleString(&#39;de-DE&#39;, {maximumFractionDigits: 2});&#xA;&#x9;&#x9; }&#xA;&#x9;&#x9; return value;&#xA;&#x9;     }&#xA;&#x9; },&#xA;     },&#xA;     plotOptions: {&#xA;&#x9; bar: {dataLabels: {position: &#39;top&#39;}}&#xA;     },&#xA;     colors: [verde, rojo, azul, gris, amarillo],&#xA;     stroke: {&#xA;&#x9; curve: &#39;smooth&#39;&#xA;     },&#xA;     grid: {&#xA;&#x9; borderColor: &#39;#e7e7e7&#39;,&#xA;&#x9; row: {&#xA;&#x9;     colors: [&#39;#f3f3f3&#39;, &#39;transparent&#39;],&#xA;&#x9;     opacity: 0.5&#xA;&#x9; },&#xA;     },&#xA;     annotations: {},&#xA;     markers: {&#xA;&#x9; size: 1&#xA;     },&#xA;     legend: {&#xA;&#x9; position: &#39;top&#39;,&#xA;&#x9; horizontalAlign: &#39;center&#39;,&#xA;&#x9; floating: false,&#xA;&#x9; offsetY: 0,&#xA;&#x9; offsetX: -5&#xA;     },&#xA;     dataLabels: {&#xA;&#x9; enabled: true,&#xA;&#x9; formatter: function(value, {seriesIndex, dataPointIndex, w}) {&#xA;&#x9;     if (value == null) {&#xA;&#x9;&#x9; value = &#39;&#39;;&#xA;&#x9;     } else if (Number(value) &lt; 100) {&#xA;&#x9;&#x9; value = value.toLocaleString(&#39;de-DE&#39;, {&#xA;&#x9;&#x9;     maximumFractionDigits: 2,&#xA;&#x9;&#x9;     minimumFractionDigits: 2});&#xA;&#x9;     } else {&#xA;&#x9;&#x9; value = (value | 0).toLocaleString(&#39;de-DE&#39;);&#xA;&#x9;     }&#xA;&#x9;     return value}&#xA;     },&#xA;     xaxis: {&#xA;&#x9; title: {&#xA;&#x9;     text: &#39;Años&#39;&#xA;&#x9; },&#xA;&#x9; tickPlacement: &#39;between&#39;,&#xA;     },&#xA;     yaxis: {&#xA;&#x9; labels: {&#xA;&#x9;     formatter: function (value) {&#xA;&#x9;&#x9; if (value == null) {&#xA;&#x9;&#x9;     value = &#39;&#39;;&#xA;&#x9;&#x9; } else if (Number(value) &lt; 100) {&#xA;&#x9;&#x9;     value = value.toLocaleString(&#39;de-DE&#39;, {minimunFractionDigits: 1});&#xA;&#x9;&#x9; } else {&#xA;&#x9;&#x9;     value = (value | 0).toLocaleString(&#39;de-DE&#39;);&#xA;&#x9;&#x9; }&#xA;&#x9;&#x9; return value;&#xA;&#x9;     }&#xA;&#x9; }&#xA;     }&#xA; };&#xA; &#xA; &#xA; &#xA; &#xA;&#xA;//js&#xA;var indTerritorio = 0;&#xA;var indYear = 1;&#xA;var medida = 3;&#xA;&#xA;var filas = [indTerritorio];&#xA;var columnas = [indYear];&#xA;&#xA;var discontinuo = true;&#xA;var orden = 1;&#xA;var AndTotal = selector(data,And,medida,orden);&#xA;&#xA;numSeries = 1;&#xA;&#xA;options.chart = {...options.chart, type: &#39;bar&#39;};&#xA;options.yaxis.title = {...options.yaxis.title, text: &#39;Índice&#39;};&#xA;options = {...options,&#xA;           plotOptions: {bar: {dataLabels: {position: &#39;top&#39;}}}};&#xA;//&#xA;&#xA;&#xA; &#xA;&#xA; var p_years = data.filter((value) =&gt; value[indTerritorio].des == And).map((value) =&gt; [value[indYear].des]);&#xA; var last_year = Math.max.apply(null, p_years);&#xA; var myyears = [];&#xA; for (let i = yearIni; i &lt;= last_year; i++) { &#xA;     myyears.push(i);&#xA; }&#xA; var prueba = data.filter((value) =&gt; value[indTerritorio].des == And).map((value) =&gt; [value[1].des])&#xA; if (discontinuo == true) {&#xA;     &#xA;     var ajusteAnd = data.filter((value) =&gt; value[indTerritorio].des == And &amp;&amp; value[indYear].des &gt;= yearIni).map((value) =&gt; [value[indYear].des, value[medida].val]);&#xA;     var ajusteEsp = data.filter((value) =&gt; value[indTerritorio].des == Esp &amp;&amp; value[indYear].des &gt;= yearIni).map((value) =&gt; [value[indYear].des, value[medida].val]);&#xA;&#xA;     var AndTotal = [];&#xA;     var EspTotal = [];&#xA;&#xA;     var ok = false;&#xA;     for (let i = 0; i &lt; myyears.length; i++) {&#xA;&#x9; let j = 0;&#xA;&#x9; ok = false;&#xA;&#x9; while (j &lt; ajusteAnd.length) {&#xA;&#x9;     if (ajusteAnd[j][0] == myyears[i]) {&#xA;&#x9;&#x9; if (ajusteEsp.length != 0) {EspTotal.push(ajusteEsp[j][1]);}&#xA;&#x9;&#x9; AndTotal.push(ajusteAnd[j][1]);&#xA;&#x9;&#x9; ok = true;&#xA;&#x9;&#x9; break;&#xA;&#x9;     } else {&#xA;&#x9;&#x9; j++;&#xA;&#x9;     }&#xA;&#x9; }&#xA;&#x9; if (ok == false) {&#xA;&#x9;     AndTotal.push(null);&#xA;&#x9;     EspTotal.push(null);&#xA;&#x9; }&#xA;     }&#xA; }&#xA;&#xA; var years = myyears;&#x9; &#xA; if (objetivo) {&#xA;     years = years_obj;&#xA; }&#xA;&#xA;&#xA; if (numSeries == 1) {&#xA;     options = {...options,&#xA;&#x9;&#x9;series: [&#xA;&#x9;&#x9;    {name: And, data: AndTotal}&#xA;&#x9;&#x9;]&#xA;     };&#xA; }&#xA;&#xA; if (numSeries == 2) {&#xA;     options = { ...options,&#xA;&#x9;&#x9; series: [&#xA;&#x9;&#x9;     {name: And, data: AndTotal, zIndex: 10},&#xA;&#x9;&#x9;     {name: Esp, data: EspTotal}&#xA;&#x9;&#x9; ]&#xA;     };&#xA; }&#xA;&#xA; if (numSeries == 3) {&#xA;     options = { ...options,&#xA;&#x9;&#x9; series: [&#xA;&#x9;&#x9;     {name: And, data: AndTotal, zIndex: 10},&#xA;&#x9;&#x9;     {name: Esp, data: EspTotal},&#xA;&#x9;&#x9;     {name: UE, data: UETotal}&#xA;&#x9;&#x9; ]&#xA;     };&#xA; }&#xA;&#xA; if (numSeries &gt; 3) {&#xA;     options = {...options,&#xA;&#x9;&#x9;series: [{ ...serie1And},&#xA;&#x9;&#x9;&#x9; { ...serie2And},&#xA;&#x9;&#x9;&#x9; { ...serie1Esp},&#xA;&#x9;&#x9;&#x9; { ...serie2Esp},&#xA;     ]};&#xA; }&#xA;&#xA; options.xaxis = {...options.xaxis, categories: years};&#xA;&#xA; eval(&#34;var Chart0 = new ApexCharts(ctx, options);&#34;);&#xA; eval(&#34;Chart0.render();&#34;);&#xA;&#xA; &#xA; if (ocultaEsp == true) {&#xA;     eval(`Chart0.hideSeries(&#39;${Esp}&#39;)`);&#xA; }&#xA; if (ocultaUE == true) {&#xA;     eval(`Chart0.hideSeries(&#39;${UE}&#39;)`);&#xA; }&#xA; ocultaEsp == false;&#xA; ocultaUE == false;&#xA;&#xA; if (ocultaCatEsp == true) {&#xA;     eval(`Chart0.hideSeries(&#39;${cat1Esp}&#39;)`);&#xA;     eval(`Chart0.hideSeries(&#39;${cat2Esp}&#39;)`);&#xA; }&#xA; ocultaCatEsp == false;&#xA;&lt;/script&gt;&#xA;&#xA;&lt;script&gt;&#xA; if (noTabla == false) {&#xA;     var datos = convertCSV(datapoints, indYear, yearIni);&#xA;     &#xA;     var valores = datos[0].indexOf(&#34;valor&#34;);&#xA;     var territ = datos[0].indexOf(&#34;Territorio&#34;);&#xA;     &#xA;     var misdatos = [];&#xA;&#xA;     if (numSeries == 1 || numSeries == 0) {&#xA;&#x9; misdatos = datos.slice(1).filter(&#xA;&#x9;     (values) =&gt; (!values[2].startsWith(&#34;estado&#34;))).filter(&#xA;&#x9;&#x9; (values) =&gt; (values[territ] == And));&#xA;     }&#xA;&#xA;     if (numSeries == 2) {&#xA;&#x9; misdatos = datos.slice(1).filter(&#xA;&#x9;     (values) =&gt; (!values[2].startsWith(&#34;estado&#34;))).filter((values) =&gt;&#xA;&#x9;&#x9; (values[territ] == And ||&#xA;&#x9;&#x9;  values[territ] == Esp));&#xA;     }&#xA;&#xA;     if (numSeries == 3) {&#xA;&#x9; misdatos = datos.slice(1).filter(&#xA;&#x9;     (values) =&gt; (!values[2].startsWith(&#34;estado&#34;))).filter((values) =&gt;&#xA;&#x9;&#x9; (values[territ] == And ||&#xA;&#x9;&#x9;  values[territ] == Esp ||&#xA;&#x9;&#x9;  values[territ] == UE));&#xA;     }&#xA;&#xA;     if (numSeries &gt; 3) {&#xA;&#x9; misdatos = datos.slice(1).filter(&#xA;&#x9;     (values) =&gt; (!values[2].startsWith(&#34;estado&#34;))).filter((values) =&gt;&#xA;&#x9;&#x9; (values[territ] == And ||&#xA;&#x9;&#x9;  values[territ] == Esp));&#xA;     }&#xA;&#xA;     var html = pivotTable(misdatos, valores, filas, columnas);&#xA;     document.getElementById(&#34;tabla-0&#34;).innerHTML = html;&#xA; }&#xA; noTabla = false;&#xA;&lt;/script&gt;</description>
